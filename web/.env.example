# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Leave VITE_FIREBASE_API_KEY empty to run against the local Emulator Suite (project demo-guardian).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web push certificate key pair (Cloud Messaging > Web configuration).
VITE_FIREBASE_VAPID_KEY=

# true = always use the emulators (auth 9099, firestore 8080, storage 9199, functions 5001).
VITE_USE_EMULATORS=false
# Host the emulators listen on (default 127.0.0.1).
VITE_EMULATOR_HOST=127.0.0.1
