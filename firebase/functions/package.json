{
  "name": "guardian-mode-functions",
  "private": true,
  "description": "Cloud Functions for Guardian Mode",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:emulator": "npm run build && firebase emulators:exec --config ../firebase.json --only auth,firestore,storage,functions --project demo-guardian \"vitest run --config vitest.emulator.config.ts\"",
    "emulators": "npm run build && firebase emulators:start --config ../firebase.json --project demo-guardian",
    "deploy": "firebase deploy --config ../firebase.json --only functions,firestore,storage"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
